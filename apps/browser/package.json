    "@tanstack/react-query": "5.102.8",
    "@tanstack/react-router": "1.170.35",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@astryxdesign/cli": "0.6.0",
    "@playwright/test": "1.63.0",
    "@tanstack/router-generator": "1.167.35",
