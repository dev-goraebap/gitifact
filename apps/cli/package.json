{
  "name": "gitifact",
  "version": "0.8.3",
  "description": "Git-backed requirements and change history for coding agents.",
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/dev-goraebap/gitifact.git", "directory": "apps/cli" },
  "homepage": "https://github.com/dev-goraebap/gitifact#readme",
  "bugs": { "url": "https://github.com/dev-goraebap/gitifact/issues" },
  "keywords": ["cli", "git", "coding-agents", "project-context"],
  "publishConfig": { "access": "public", "registry": "https://registry.npmjs.org/", "tag": "latest" },
  "type": "module",
  "bin": {
    "gitifact": "dist/main.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test:built": "tsc -p tsconfig.test.json && node --import ./test/locale.mjs --test --test-concurrency=4 test/*.test.mjs"
  },
  "devDependencies": {
    "@gitifact/core": "workspace:*",
    "@gitifact/contracts": "workspace:*",
    "commander": "15.0.0",
    "esbuild": "0.28.2"
  }
}
