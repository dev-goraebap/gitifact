{
  "name": "@tryce/cli",
  "version": "0.3.0",
  "description": "Git-backed project context and decision notes for coding agents.",
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/dev-goraebap/tryce.git", "directory": "apps/cli" },
  "homepage": "https://github.com/dev-goraebap/tryce#readme",
  "bugs": { "url": "https://github.com/dev-goraebap/tryce/issues" },
  "keywords": ["cli", "git", "coding-agents", "project-context"],
  "publishConfig": { "access": "public", "registry": "https://registry.npmjs.org/", "tag": "latest" },
  "type": "module",
  "bin": {
    "tryce": "dist/main.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test:built": "tsc -p tsconfig.test.json && node --test test/*.test.mjs"
  },
  "devDependencies": {
    "@tryce/core": "workspace:*",
    "@tryce/contracts": "workspace:*",
    "commander": "15.0.0",
    "esbuild": "0.28.2"
  }
}
